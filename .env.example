# If empty, DevTunnelProvider use http://127.0.0.1
# Use this env if tunnel need call from docker container but hbrc run on host machine (ex: http://host.docker.internal)
MAIN_VITE_DEV_TUNNEL_URL=

# Set to true to accept self-signed TLS certs from the backend (MQTT/HTTP transporters). Local dev only.
MAIN_VITE_TRANSPORTER_INSECURE_TLS=
